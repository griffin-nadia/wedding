    "qr-cards": "node scripts/qr-cards.mjs",
    "check:pending": "node scripts/check-pending.mjs",
    "lab": "node scripts/lab-serve.mjs",
    "test:e2e": "playwright test",
    "test:e2e:update": "playwright test --update-snapshots"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oranienbaum": "^5.3.0",
    "@fontsource/zen-old-mincho": "^5.3.0",
    "@paper-design/shaders": "^0.0.81",
    "@paper-design/shaders-react": "^0.0.81",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.49.0",
    "qrcode-generator": "^2.0.4",
    "radix-ui": "^1.6.7",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.18.4",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
